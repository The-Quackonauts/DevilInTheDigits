[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/time_vortex.gd" id="1_vortex"]

[sub_resource type="Shader" id="Shader_tunnel"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

void fragment() {
	float ribs = pow(max(0.0, sin(UV.y * 720.0 + TIME * 72.0)), 18.0);
	float spiral = pow(max(0.0, sin(UV.x * 75.0 + UV.y * 190.0 + TIME * 34.0)), 12.0);
	float pulse = 0.55 + 0.45 * sin(UV.y * 90.0 + TIME * 22.0);
	vec3 violet = vec3(0.24, 0.02, 0.65);
	vec3 cyan = vec3(0.0, 0.85, 1.0);
	vec3 color = violet * (0.18 + pulse * 0.2) + cyan * ribs * 2.8 + vec3(1.0, 0.12, 0.75) * spiral;
	ALBEDO = color;
	EMISSION = color * 2.2;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_tunnel"]
shader = SubResource("Shader_tunnel")

